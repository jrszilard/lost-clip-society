---
import fs from "node:fs";
import path from "node:path";
import { fitmentLabel, oemIdentityLabel, type Part } from "../lib/catalog";
import Stamp from "./Stamp.astro";
interface Props { part: Part }
const { part } = Astro.props;

// Imagery follows the state ladder: once a part is modeled it gets a neutral-resin
// render at public/images/parts/<slug>.jpg (scripts/render-part.py). Until then the
// card shows an honest "evidence pending" plate — we never fake a photo of a part
// we haven't touched.
const imgSrc = `/images/parts/${part.slug}.jpg`;
const hasImage = fs.existsSync(path.join(process.cwd(), "public", "images", "parts", `${part.slug}.jpg`));

const cta: Record<string, string> = {
  fitted: "Order this part",
  measured: "Order this part",
  development: "Reserve one",
  requested: "Vote or sponsor",
};
// Status paint-coding: the band echoes the state stamp below it — one glance
// at the top of the card signals where the part sits on the ladder.
const statusPaint: Record<string, string> = {
  requested: "var(--status-requested)",
  development: "var(--status-development)",
  measured: "var(--status-measured)",
  fitted: "var(--status-measured)",
};
const statePaint = statusPaint[part.state];
const oemLabel = oemIdentityLabel(part);
const vehicleFitment = fitmentLabel(part);
---
<article class="case"
  data-state={part.state}
  data-search={`${part.title} ${part.oemNumber ?? ""} ${part.supersededTo ?? ""} ${part.yearRange} ${part.category} ${part.vehicleLabel ?? ""}`.toLowerCase()}
>
  <div class="cat-band" style={`background:${statePaint}`}></div>
  {hasImage ? (
    <div class="thumb">
      <img src={imgSrc} alt={`${part.title} — reproduction render, neutral resin`}
           width="1024" height="768" loading="lazy" decoding="async" />
    </div>
  ) : (
    <div class="thumb pending" role="img" aria-label={`${part.title} — no artwork yet; part is still requested`}>
      <div class="pending-note">
        <span class="pending-label">Evidence pending</span>
        <span class="pending-sub">Awaiting an original —<br />artwork follows the donor part</span>
      </div>
    </div>
  )}
  <div class="tab">
    <span>{oemLabel}</span>
  </div>
  <h3><a href={`/registry/${part.slug}/`}>{part.title}</a></h3>
  <div class:list={["meta", { "fitment-warning": part.fitmentStatus !== "confirmed" }]}>
    {vehicleFitment}{part.colors.length > 1 ? ` · originally ${part.colors.length} colors` : ""}
  </div>
  <div class="foot">
    <Stamp state={part.state} label={part.stateLabel} />
    <a class="act" href={`/registry/${part.slug}/`}>{cta[part.state]}</a>
  </div>
</article>

<style>
  .case {
    background: var(--panel); color: var(--panel-fg);
    border: var(--border-hairline) solid var(--panel-line);
    display: flex; flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .case:hover { transform: translateY(-3px); box-shadow: var(--shadow-card); }
  .cat-band { height: 5px; }
  .thumb {
    position: relative; aspect-ratio: 4 / 3; min-height: 0;
    display: flex; align-items: center; justify-content: center;
    background: var(--bg-2); border-bottom: var(--border-hairline) solid var(--panel-line);
    color: var(--panel-dim); font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: var(--tracking-label); text-transform: uppercase;
    overflow: hidden;
  }
  /* absolutely filled so the img can't feed its intrinsic height back into the
     flex column and defeat the thumb's 4/3 ratio */
  .thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  /* "Evidence pending" — graph-paper case-file plate for parts with no artifact yet.
     Same blueprint ruling as the dimension tables; never a fake photo. */
  .pending {
    background:
      repeating-linear-gradient(0deg, transparent, transparent 23px, rgba(15, 128, 196, 0.10) 24px),
      repeating-linear-gradient(90deg, transparent, transparent 23px, rgba(15, 128, 196, 0.10) 24px),
      var(--panel);
  }
  .pending-note { text-align: center; padding: 0 var(--space-3); }
  .pending-label {
    display: inline-block; border: 1.5px dashed var(--panel-dim); padding: 5px 10px;
    letter-spacing: var(--tracking-label); color: var(--panel-dim);
  }
  .pending-sub {
    display: block; margin-top: 10px; letter-spacing: 0.04em; line-height: 1.5;
    text-transform: none; font-size: 0.66rem; opacity: 0.85;
  }
  .tab {
    font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: 0.12em; color: var(--panel-dim);
    padding: 10px 16px 0; display: flex; justify-content: space-between; gap: var(--space-2);
  }
  h3 { font-size: var(--text-lg); padding: 6px 16px 0; }
  h3 a { text-decoration: none; }
  h3 a:hover { color: var(--action); }
  .meta { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--panel-dim); padding: 4px 16px 12px; }
  .fitment-warning { color: var(--status-development); font-weight: 700; }
  .foot {
    margin-top: auto; padding: var(--space-3) 16px 16px;
    display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap;
  }
  .act {
    font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none;
    color: var(--action); border: var(--border-hairline) solid var(--action); padding: 8px 10px;
    white-space: nowrap;
  }
  .act:hover { background: var(--action); color: var(--action-fg); }
</style>
