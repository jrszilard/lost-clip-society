---
import Base from "../layouts/Base.astro";
import PartCard from "../components/PartCard.astro";
import { allParts } from "../lib/catalog";
import { ClipboardList, Search, Ruler, Printer, CarFront } from "lucide-astro";

const parts = allParts();
const featured = parts.slice(0, 3);
---
<Base title="The Lost Clip Society: We remake the car parts nobody sells anymore">
  <div class="wrap hero">
    <div>
      <h1>We remake the car parts <span class="mk">nobody sells anymore.</span></h1>
      <p class="sub">
        3D printed faithful reproductions of hard-to-find car parts.
      </p>
      <div class="cta-row">
        <a class="btn primary" href="/registry/">Browse the parts</a>
        <a class="btn ghost" href="/request/">Request a part we don’t have</a>
      </div>
    </div>
    <div class="badge-holder">
      <div class="hero-image-slot" role="img" aria-label="Hero image placeholder">
        <span>Hero image</span>
      </div>
    </div>
  </div>

  <section id="how">
    <div class="wrap">
      <div class="sec-head"><h2>How it works</h2><div class="rule"></div></div>
      <div class="steps">
        <div class="step"><ClipboardList class="step-icon" size={28} strokeWidth={1.6} /><h3>You request a part</h3>
          <p>Tell us your car and the part you can’t buy anymore. It enters the catalog with its full OEM paper trail.</p></div>
        <div class="step"><Search class="step-icon" size={28} strokeWidth={1.6} /><h3>We research it</h3>
          <p>We trace every part number it ever wore and draft the shape. Drafts are always labeled drafts.</p></div>
        <div class="step"><Ruler class="step-icon" size={28} strokeWidth={1.6} /><h3>We measure an original</h3>
          <p>A surviving part meets the calipers: yours, a donor’s, or one we source. Every critical dimension, published.</p></div>
        <div class="step"><Printer class="step-icon" size={28} strokeWidth={1.6} /><h3>Made to order</h3>
          <p>You order; we print, inspect, and ship yours. It fits, or we remake it free. Group runs lower the price when demand pools.</p></div>
        <div class="step"><CarFront class="step-icon" size={28} strokeWidth={1.6} /><h3>Fitted on a real car</h3>
          <p>The part goes on an actual car and gets confirmed: car, year, and material on the record. Only then does it wear the badge.</p></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <h2>Parts we’re bringing back</h2>
        <div class="rule"></div>
        <a href="/registry/">See all {parts.length} parts →</a>
      </div>
      <div class="cases">{featured.map((p) => <PartCard part={p} />)}</div>
    </div>
  </section>

  <section id="society">
    <div class="wrap society">
      <div class="join">
        <div class="eyebrow">Membership · free</div>
        <h2>Join the Society.</h2>
        <p>
          Free, forever, and numbered. Members vote on which part we tackle next, get notified
          when their part reaches production, and share fit reports that make every listing more
          trustworthy. The parts cost money. Membership never does.
        </p>
        <div class="join-row">
          <input type="email" placeholder="you@garage.example" aria-label="Email address" />
          <a class="btn primary" href="#society">Claim a member number</a>
        </div>
        <small>Members get <b>The Missing Knob</b>, our bulletin. It ships only when a part moves forward.</small>
      </div>
      <div class="m-card" role="img" aria-label="Sample membership card">
        <div class="mc-top">
          <span class="mc-title">THE LOST CLIP SOCIETY</span>
          <span class="mc-no">MEMBER № 0001</span>
        </div>
        <dl>
          <dt>Chapter</dt><dd>A60 · Celica Supra</dd>
          <dt>Standing</dt><dd>Fitment Officer</dd>
          <dt>Testimony</dt><dd>1 part measured (18 dims)</dd>
          <dt>Since</dt><dd>2026</dd>
        </dl>
        <div class="oath">“I solemnly swear to measure twice.”</div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: var(--space-6); align-items: center; padding: var(--space-7) 24px 56px; }
  .hero h1 { font-size: var(--text-hero); line-height: 1.08; }
  /* Sublime is a highlighter, never a surface — this is its one job. */
  .hero h1 .mk { box-shadow: inset 0 -0.26em 0 color-mix(in srgb, var(--paint-sublime) 65%, transparent); }
  .sub { max-width: 56ch; color: var(--fg-dim); margin: 18px 0 26px; }
  .sub em { color: var(--fg); font-style: normal; border-bottom: 2px solid var(--action); }
  .cta-row { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .badge-holder { display: flex; justify-content: center; }
  .hero-image-slot {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--panel);
    border: var(--border-hairline) dashed var(--edge);
    color: var(--panel-dim);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  @media (max-width: 820px) { .hero { grid-template-columns: 1fr; } .badge-holder { order: -1; } }

  .cases { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: var(--space-4); }

  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1px; background: var(--edge); border: var(--border-hairline) solid var(--edge); }
  .step { background: var(--bg-2); padding: var(--space-4) 18px; }
  .step-icon { color: var(--action); display: block; margin-bottom: 10px; }
  .step h3 { font-size: 1.02rem; margin: 8px 0 6px; }
  .step p { font-size: 0.82rem; color: var(--fg-dim); margin: 0; }

  .society { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); align-items: center; }
  @media (max-width: 820px) { .society { grid-template-columns: 1fr; } }
  .join h2 { font-size: 1.7rem; margin-bottom: 10px; }
  .join p { color: var(--fg-dim); max-width: 52ch; }
  .join-row { display: flex; gap: 10px; margin-top: 18px; flex-wrap: wrap; }
  .join-row input { font-family: var(--font-mono); font-size: 0.85rem; padding: 12px 14px; min-width: 240px; background: var(--bg-2); border: var(--border-hairline) solid var(--edge); color: var(--fg); }
  .join small { display: block; margin-top: 10px; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--fg-dim); }

  .m-card { background: linear-gradient(135deg, #efe7d3, #e4d9bd); color: #26221a; border: 1px solid #cfc2a0; padding: 22px 24px; max-width: 420px; box-shadow: var(--shadow-card); transform: rotate(-1.2deg); }
  .mc-top { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--brand-oxblood); padding-bottom: 10px; margin-bottom: 14px; }
  .mc-title { font-family: var(--font-display); font-size: 0.95rem; }
  .mc-no { font-family: var(--font-mono); font-size: 0.8rem; color: var(--brand-oxblood); font-weight: 700; }
  .m-card dl { display: grid; grid-template-columns: auto 1fr; gap: 4px 16px; margin: 0; font-size: 0.8rem; }
  .m-card dt { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: var(--tracking-label); text-transform: uppercase; color: #8a8067; align-self: center; }
  .m-card dd { margin: 0; font-family: var(--font-mono); }
  .oath { margin-top: 14px; font-family: var(--font-display); font-style: italic; font-size: 0.86rem; color: #514a38; }
</style>
