---
import Base from "../../layouts/Base.astro";
import PartCard from "../../components/PartCard.astro";
import { allParts } from "../../lib/catalog";
const parts = allParts();
---
<Base title="Parts Catalog — The Ministry of Discontinued Parts">
  <section>
    <div class="wrap">
      <div class="sec-head">
        <h2>The catalog</h2>
        <div class="rule"></div>
        <a href="/request/">Missing something? Request it →</a>
      </div>
      <p class="lede">
        Every part we know about, whatever its state — from freshly requested to fitted on a
        real car. Pages live here forever; the state changes as the work happens.
      </p>

      <div class="tools">
        <input id="q" type="search" enterkeyhint="search"
               placeholder="Search the catalog — part name, OEM №, keyword…"
               aria-label="Search the catalog" autocomplete="off" spellcheck="false" />
        <div class="chips" role="group" aria-label="Filter by state">
          <button type="button" class="chip on" data-state="">All</button>
          <button type="button" class="chip" data-state="measured">Measured</button>
          <button type="button" class="chip" data-state="development">In development</button>
          <button type="button" class="chip" data-state="requested">Requested</button>
        </div>
      </div>
      <p class="count" id="count" aria-live="polite"></p>

      <div class="cases" id="grid">{parts.map((p) => <PartCard part={p} />)}</div>

      <div class="empty" id="empty" hidden>
        <div class="empty-stamp">No match in the catalog</div>
        <p>
          Which means nobody’s asked for it yet. Open a case file and it starts existing —
          every part above got in exactly this way.
        </p>
        <a class="btn primary" id="empty-cta" href="/request/">Open a case file →</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const input = document.getElementById("q") as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>(".chip")];
  const cards = [...document.querySelectorAll<HTMLElement>("#grid .case")];
  const count = document.getElementById("count");
  const empty = document.getElementById("empty");
  const emptyCta = document.getElementById("empty-cta") as HTMLAnchorElement;
  let state = "";

  function apply(updateUrl = true) {
    const q = input.value.trim().toLowerCase();
    const terms = q.split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const card of cards) {
      const hay = card.dataset.search ?? "";
      const okState = !state || card.dataset.state === state;
      const okText = terms.every((t) => hay.includes(t));
      const show = okState && okText;
      card.hidden = !show;
      if (show) shown++;
    }
    count.textContent = `Showing ${shown} of ${cards.length}`;
    empty.hidden = shown !== 0;
    emptyCta.href = q ? `/request/?part=${encodeURIComponent(input.value.trim())}` : "/request/";
    if (updateUrl) {
      const url = new URL(location.href);
      if (q) url.searchParams.set("q", input.value.trim()); else url.searchParams.delete("q");
      history.replaceState(null, "", url);
    }
  }

  input.addEventListener("input", () => apply());
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      chips.forEach((c) => c.classList.toggle("on", c === chip));
      state = chip.dataset.state ?? "";
      apply(false);
    }),
  );

  const initial = new URLSearchParams(location.search).get("q");
  if (initial) input.value = initial;
  apply(false);
</script>

<style>
  .lede { color: var(--fg-dim); max-width: 62ch; margin: 0 0 var(--space-5); }

  .tools { display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap; margin-bottom: var(--space-2); }
  #q {
    flex: 1 1 320px; font-family: var(--font-mono); font-size: 0.9rem;
    padding: 12px 14px; background: var(--panel); color: var(--panel-fg);
    border: var(--border-hairline) solid var(--edge);
  }
  #q:focus { outline: 2px solid var(--action); outline-offset: 1px; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .chip {
    font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-label);
    text-transform: uppercase; padding: 8px 12px; cursor: pointer;
    background: transparent; color: var(--fg-dim); border: var(--border-hairline) solid var(--edge);
  }
  .chip:hover { color: var(--action); border-color: var(--action); }
  .chip.on { background: var(--action); border-color: var(--action); color: var(--action-fg); }
  .count { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--fg-dim); margin: 6px 0 var(--space-3); }

  /* auto-fill (not auto-fit): filtered-down results keep card width instead of stretching */
  .cases { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: var(--space-4); }
  .cases :global(.case[hidden]) { display: none; }

  .empty {
    margin-top: var(--space-4); background: var(--panel); color: var(--panel-fg);
    border: var(--border-hairline) solid var(--panel-line); box-shadow: var(--shadow-card);
    padding: var(--space-5); max-width: 560px;
  }
  .empty-stamp {
    display: inline-block; font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 700;
    letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--status-requested);
    border: var(--border-stamp) solid var(--status-requested); border-radius: var(--radius-stamp);
    padding: 6px 10px; transform: rotate(-2deg); margin-bottom: var(--space-3);
  }
  .empty p { color: var(--panel-dim); max-width: 52ch; }
</style>
