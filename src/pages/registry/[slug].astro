---
import fs from "node:fs";
import path from "node:path";
import Base from "../../layouts/Base.astro";
import Stamp from "../../components/Stamp.astro";
import SpecTable from "../../components/SpecTable.astro";
import { allParts } from "../../lib/catalog";

export function getStaticPaths() {
  return allParts().map((part) => ({ params: { slug: part.slug }, props: { part } }));
}
const { part } = Astro.props;
const orderable = part.state === "measured" || part.state === "fitted";

// Neutral-resin render, once the part is modeled (scripts/render-part.py).
const imgSrc = `/images/parts/${part.slug}.jpg`;
const hasImage = fs.existsSync(path.join(process.cwd(), "public", "images", "parts", `${part.slug}.jpg`));
---
<Base title={`${part.title} — ${part.oemNumber ?? "OEM"} reproduction — The Lost Clip Society`}
      description={part.description.slice(0, 155)}>
  <section>
    <div class="wrap">
      <div class="crumbs"><a href="/registry/">Catalog</a> / {part.title}</div>
      <div class="head">
        <div>
          <div class="eyebrow">{part.oemNumber ? `OEM № ${part.oemNumber}` : "OEM № pending"} · {part.yearRange} Toyota Celica Supra</div>
          <h1>{part.title}</h1>
        </div>
        <Stamp state={part.state} label={part.stateLabel} />
      </div>

      {hasImage && (
        <figure class="media">
          <img src={imgSrc} alt={`${part.title} — reproduction render, neutral resin`}
               width="1024" height="768" />
          <figcaption>
            Reproduction render · neutral resin{part.colors.length > 0 && ` · original came in ${part.colors.join(", ")} — yours can too`}
          </figcaption>
        </figure>
      )}

      <div class="panel">
        <div class="brief">
          <p>{part.description}</p>
          {part.supersededTo && (
            <p class="paper-trail">
              <b>The paper trail:</b> superseded to {part.supersededTo}
              {part.colors.length > 1 &&
                ` — originally available in ${part.colors.join(", ")}; the replacement came only in Black. Ours can come in your color.`}
            </p>
          )}
        </div>
        {part.dims.length > 0 && (
          <SpecTable dims={part.dims} confirmed={part.dimsConfirmed} total={part.dimsTotal} />
        )}
        <div class="actions">
          <div class="commission">
            <div class="blk-label">Get this part</div>
            {orderable ? (
              <div class="row">
                <a class="btn primary" href="/request/">Order this part</a>
                <span class="cap">Made to order, one at a time · <b>fits or we remake it free</b> · ships with its own fit-report card</span>
              </div>
            ) : part.state === "development" ? (
              <div class="row">
                <a class="btn primary" href="/request/">Reserve one</a>
                <span class="cap">In development — reserving bumps it up the queue and locks your place</span>
              </div>
            ) : (
              <div class="row">
                <a class="btn primary" href="/request/">Vote or sponsor</a>
                <span class="cap">Not started yet — votes move it up the queue; sponsoring starts it now</span>
              </div>
            )}
          </div>
          <div class="assist">
            <div class="blk-label">Help out · optional</div>
            <p>Own an original, or fitted one of ours? A quick report makes the record stronger.</p>
            <a href="/#society">Share a fit report</a>
            <a href="/#society">Get notified about this part</a>
          </div>
        </div>
      </div>

      {part.fitReports.length > 0 && (
        <div class="testimony">
          <h2>Fit reports</h2>
          {part.fitReports.map((r) => (
            <div class="report">
              FIT REPORT · {r.vehicle} · {r.material} · <b>{r.result.toUpperCase()}</b>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .crumbs { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--fg-dim); margin-bottom: var(--space-4); text-transform: uppercase; letter-spacing: 0.1em; }
  .crumbs a { text-decoration: none; }
  .head { display: flex; justify-content: space-between; align-items: start; gap: var(--space-4); margin-bottom: var(--space-5); flex-wrap: wrap; }
  h1 { font-size: 2rem; margin-top: 6px; }
  .media { margin: 0 0 var(--space-5); max-width: 560px; background: var(--panel); border: var(--border-hairline) solid var(--panel-line); }
  .media img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .media figcaption {
    font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: var(--tracking-label); text-transform: uppercase;
    color: var(--panel-dim); padding: 8px 12px;
    border-top: var(--border-hairline) solid var(--panel-line);
  }
  .panel { background: var(--panel); color: var(--panel-fg); border: var(--border-hairline) solid var(--panel-line); }
  .brief { padding: var(--space-5); }
  .brief p { max-width: 70ch; margin: 0 0 var(--space-3); }
  .paper-trail { font-size: 0.88rem; color: var(--panel-dim); }
  .actions { display: grid; grid-template-columns: 1.2fr 1fr; border-top: var(--border-hairline) solid var(--panel-line); }
  @media (max-width: 820px) { .actions { grid-template-columns: 1fr; } }
  .commission { padding: var(--space-4) var(--space-5); background: var(--brand-cream-2); border-right: var(--border-hairline) solid var(--panel-line); }
  .assist { padding: var(--space-4) var(--space-5); }
  .blk-label { font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 10px; }
  .commission .blk-label { color: var(--action); }
  .assist .blk-label { color: var(--panel-dim); }
  .row { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .cap { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--panel-dim); max-width: 40ch; }
  .assist p { font-size: 0.82rem; margin: 0 0 10px; }
  .assist a { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--panel-dim); margin-right: var(--space-3); }
  .assist a:hover { color: var(--action); }
  .testimony { margin-top: var(--space-5); }
  .testimony h2 { font-size: var(--text-lg); margin-bottom: var(--space-3); }
  .report { font-family: var(--font-mono); font-size: 0.78rem; color: var(--fg-dim); border-left: 3px solid var(--status-measured); padding: 10px 14px; margin-bottom: var(--space-2); }
</style>
